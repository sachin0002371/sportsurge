{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sportsurge",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "sportsurgeplay.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_URL": "https://backend.sportsurgeplay.com",
    "DATABASE_URL": "postgresql://neondb_owner:npg_MANZ9RS4QUad@ep-billowing-paper-asl1j3hb.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require"
  }
}
